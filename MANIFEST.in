# What goes into a source distribution beyond the Python package.
#
# The Rust source is included so that installing from an sdist can build the
# native library, exactly as a clone can. Build output is not: it is large,
# platform-specific, and regenerated by any build that needs it.

include README.md
include ARCHITECTURE.md
include LICENSE
include MANIFEST.in

graft rust
prune rust/target

graft tests
graft examples

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude *.dll
global-exclude *.dylib
